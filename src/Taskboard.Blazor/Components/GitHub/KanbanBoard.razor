@inject IGitHubService GitHubService
@inject IAgentOrchestrationService OrchestrationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (_isLoading)
{
    <div class="d-flex align-center">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
        <MudText>Carregando issues...</MudText>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}
else if (_columns is not null)
{
    <div class="kanban-actions mb-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewTaskDialogAsync">
            Nova Tarefa
        </MudButton>
    </div>

    <div class="kanban-board">
        @foreach (var column in _columns)
        {
            <div class="kanban-column"
                 @ondrop="() => OnDropAsync(column.Column)"
                 @ondrop:preventDefault="true"
                 @ondragover="OnDragOver"
                 @ondragover:preventDefault="true">
                <div class="kanban-column-header">
                    <h4>@column.Column (@column.Issues.Count)</h4>
                    <span class="kanban-label">@column.Label</span>
                </div>
                <div class="kanban-column-body">
                    @foreach (var issue in column.Issues)
                    {
                        <div class="kanban-card"
                             draggable="true"
                             @ondragstart="() => OnDragStart(issue, column.Column)"
                             @onclick="() => OpenTaskDetailAsync(issue)">
                            <div class="kanban-card-title">@issue.Title</div>
                            <div class="kanban-card-meta">
                                <span>#@issue.Number</span>
                                @if (!string.IsNullOrWhiteSpace(issue.AssigneeLogin))
                                {
                                    <span title="@issue.AssigneeLogin">@@@issue.AssigneeLogin</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(issue.Body))
                            {
                                <div class="kanban-card-body">@issue.Body</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    private bool _isLoading;
    private string? _errorMessage;
    private IReadOnlyList<BoardColumnDto>? _columns;
    private IssueDto? _draggedIssue;
    private GitHubBoardColumn? _draggedFromColumn;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(RepositoryFullName))
        {
            await LoadIssuesAsync();
        }
    }

    private async Task LoadIssuesAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var issues = await GitHubService.GetIssuesAsync(RepositoryFullName, GitHubBoardColumnExtensions.GetAllLabels());
            _columns = GroupIssuesByColumn(issues);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao carregar issues: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static IReadOnlyList<BoardColumnDto> GroupIssuesByColumn(IReadOnlyList<IssueDto> issues)
    {
        return Enum.GetValues<GitHubBoardColumn>()
            .Select(column => new BoardColumnDto(
                column,
                column.ToLabel(),
                issues.Where(i => i.Column == column).OrderByDescending(i => i.UpdatedAt).ToList().AsReadOnly()))
            .ToList()
            .AsReadOnly();
    }

    private void OnDragStart(IssueDto issue, GitHubBoardColumn fromColumn)
    {
        _draggedIssue = issue;
        _draggedFromColumn = fromColumn;
    }

    private static void OnDragOver(DragEventArgs args)
    {
        // Necessário para permitir o drop.
    }

    private async Task OnDropAsync(GitHubBoardColumn toColumn)
    {
        if (_draggedIssue is null || _draggedFromColumn == toColumn)
        {
            return;
        }

        var issue = _draggedIssue;
        var fromColumn = _draggedFromColumn;

        _draggedIssue = null;
        _draggedFromColumn = null;

        try
        {
            if (toColumn is GitHubBoardColumn.InProgress or GitHubBoardColumn.Backlog)
            {
                var request = await OpenAgentSelectionModalAsync(issue);
                if (request is null)
                {
                    return;
                }

                await GitHubService.UpdateIssueColumnAsync(RepositoryFullName, issue.Number, fromColumn, toColumn);
                await GitHubService.AddLabelsToIssueAsync(RepositoryFullName, issue.Number, [request.AgentType.ToLabel()]);
                await OrchestrationService.EnqueueAsync(request);
                Snackbar.Add($"Issue #{issue.Number} movida para {toColumn.ToLabel()} e agente {request.AgentType} iniciado.", Severity.Success);
            }
            else
            {
                await GitHubService.UpdateIssueColumnAsync(RepositoryFullName, issue.Number, fromColumn, toColumn);
                Snackbar.Add($"Issue #{issue.Number} movida para {toColumn.ToLabel()}.", Severity.Success);
            }

            await LoadIssuesAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao mover issue: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
    }

    private async Task<AgentExecutionRequest?> OpenAgentSelectionModalAsync(IssueDto issue)
    {
        var parameters = new DialogParameters<AgentSelectionModal>
        {
            { d => d.Issue, issue },
            { d => d.RepositoryFullName, RepositoryFullName }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AgentSelectionModal>("Selecionar Agente CLI", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not AgentExecutionRequest request)
        {
            return null;
        }

        return request;
    }

    private async Task OpenTaskDetailAsync(IssueDto issue)
    {
        var parameters = new DialogParameters<TaskDetailDialog>
        {
            { d => d.Issue, issue },
            { d => d.RepositoryFullName, RepositoryFullName }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<TaskDetailDialog>($"Issue #{issue.Number}", parameters, options);
    }

    private async Task OpenNewTaskDialogAsync()
    {
        var parameters = new DialogParameters<NewTaskDialog>
        {
            { d => d.RepositoryFullName, RepositoryFullName }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<NewTaskDialog>("Nova Tarefa", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is true)
        {
            await LoadIssuesAsync();
        }
    }
}
