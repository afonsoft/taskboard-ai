@inject IGitHubService GitHubService
@inject ISnackbar Snackbar

<MudCard Elevation="1" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6">GitHub</MudText>

    <MudTextField T="string"
                  Label="Personal Access Token"
                  @bind-Value="_token"
                  InputType="InputType.Password"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.Save"
                  OnAdornmentClick="ApplyTokenAsync"
                  HelperText="Use a variável de ambiente GITHUB_TOKEN ou informe o token aqui."
                  Class="mb-2" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyTokenAsync" Disabled="_isApplyingToken">
        @if (_isApplyingToken)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        Aplicar Token
    </MudButton>

    @if (_repositories is not null)
    {
        <MudSelect T="RepositoryDto"
                   Label="Repositório"
                   Value="_selectedRepository"
                   ValueChanged="OnRepositoryChanged"
                   ToStringFunc="r => r?.FullName ?? string.Empty"
                   Disabled="_isLoading"
                   Class="mt-4">
            @foreach (var repository in _repositories)
            {
                <MudSelectItem Value="repository">@repository.FullName</MudSelectItem>
            }
        </MudSelect>
    }

    @if (_isLoading)
    {
        <div class="d-flex align-center mt-4">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            <MudText>Carregando repositórios...</MudText>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
    }
</MudCard>

@code {
    private string _token = string.Empty;
    private bool _isApplyingToken;
    private bool _isLoading;
    private string? _errorMessage;
    private IReadOnlyList<RepositoryDto>? _repositories;
    private RepositoryDto? _selectedRepository;

    [Parameter]
    public EventCallback<string> OnRepositorySelected { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadRepositoriesAsync();
    }

    private async Task ApplyTokenAsync()
    {
        if (string.IsNullOrWhiteSpace(_token))
        {
            Snackbar.Add("Informe um token válido.", Severity.Warning);
            return;
        }

        _isApplyingToken = true;
        _errorMessage = null;

        try
        {
            GitHubService.SetToken(_token);
            await LoadRepositoriesAsync();
            Snackbar.Add("Token aplicado com sucesso.", Severity.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao aplicar token: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isApplyingToken = false;
        }
    }

    private async Task LoadRepositoriesAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _repositories = null;

        try
        {
            _repositories = await GitHubService.GetRepositoriesAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao carregar repositórios: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnRepositoryChanged(RepositoryDto? repository)
    {
        _selectedRepository = repository;

        if (repository is not null)
        {
            await OnRepositorySelected.InvokeAsync(repository.FullName);
        }
    }
}
