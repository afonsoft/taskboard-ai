@using System.Globalization

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="pa-4">
            <MudTabPanel Text="Detalhes">
                <MudText Typo="Typo.h6" Class="mb-2">@Issue?.Title</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    <strong>Repositório:</strong> @RepositoryFullName
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    <strong>Coluna:</strong> @Issue?.Column.ToLabel()
                </MudText>
                @if (!string.IsNullOrWhiteSpace(Issue?.Body))
                {
                    <MudText Typo="Typo.body1" Class="mt-4">@Issue.Body</MudText>
                }
                <MudLink Href="@Issue?.HtmlUrl" Target="_blank" Class="mt-4 d-block">Abrir no GitHub</MudLink>
            </MudTabPanel>
            <MudTabPanel Text="Logs do Agente">
                @if (Issue is not null)
                {
                    <TaskLogTab IssueId="@Issue.Id.ToString(CultureInfo.InvariantCulture)" />
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public IssueDto? Issue { get; set; }

    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    private void Close() => MudDialog.Close();
}
