@page "/settings"
@attribute [Authorize]
@inject TaskboardClient Client
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Settings - Taskboard</PageTitle>

<h1 class="mb-2 text-2xl font-bold text-text">Settings</h1>
<p class="mb-6 text-sm text-text-muted">Customize your workspace and agents</p>

<div class="card mb-6">
    <h2 class="mb-4 text-lg font-semibold text-text">Preferences</h2>
    <div class="space-y-4">
        <label class="flex items-center gap-3">
            <input type="checkbox" class="checkbox" @bind="_isDark" />
            <span class="text-sm text-text">Dark mode</span>
        </label>
        <div>
            <label for="github-token" class="mb-1 block text-sm font-medium text-text">GitHub token</label>
            <input id="github-token" type="password" class="input" @bind="_gitHubToken" placeholder="ghp_***" />
        </div>
    </div>
</div>

<div class="card mb-6">
    <h2 class="mb-4 text-lg font-semibold text-text">Change password</h2>
    <div class="space-y-4">
        <div>
            <label for="current-password" class="mb-1 block text-sm font-medium text-text">Current password</label>
            <input id="current-password" type="password" class="input" @bind="_currentPassword" />
        </div>
        <div>
            <label for="new-password" class="mb-1 block text-sm font-medium text-text">New password</label>
            <input id="new-password" type="password" class="input" @bind="_newPassword" />
        </div>
        <div>
            <label for="confirm-password" class="mb-1 block text-sm font-medium text-text">Confirm new password</label>
            <input id="confirm-password" type="password" class="input" @bind="_confirmPassword" />
        </div>
        @if (!string.IsNullOrWhiteSpace(_passwordError))
        {
            <p class="text-sm text-danger">@_passwordError</p>
        }
        <button type="button" class="btn-secondary" @onclick="ChangePasswordAsync">Change password</button>
    </div>
</div>

<div class="card mb-6">
    <h2 class="mb-4 text-lg font-semibold text-text">Agents</h2>
    @if (_loading)
    {
        <Loading Message="Loading agents..." />
    }
    else if (!_agents.Any())
    {
        <EmptyState Message="No agents discovered." />
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Version</th>
                        <th>Enabled</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var agent in _agents)
                    {
                        <tr>
                            <td>@agent.Name</td>
                            <td class="text-text-muted">@agent.Version</td>
                            <td>
                                <input type="checkbox" class="checkbox" checked="@_enabled.Contains(agent.Type)" @onchange="e => ToggleAgent(agent.Type, (bool)e.Value!)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<button type="button" class="btn-primary" @onclick="SaveAsync">Save settings</button>

@code {
    private bool _isDark = true;
    private bool _loading = true;
    private string? _gitHubToken;
    private IReadOnlyList<AgentPreferenceDto> _agents = [];
    private HashSet<AgentType> _enabled = new();

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _passwordError;

    protected override async Task OnInitializedAsync()
    {
        var settings = await Client.GetSettingsAsync();
        _isDark = settings.Theme != "light";
        _gitHubToken = settings.GitHubToken;
        _agents = settings.Agents;
        _enabled = new HashSet<AgentType>(settings.Agents.Where(a => a.Enabled).Select(a => a.Type));
        _loading = false;
    }

    private void ToggleAgent(AgentType type, bool enabled)
    {
        if (enabled)
        {
            _enabled.Add(type);
        }
        else
        {
            _enabled.Remove(type);
        }
    }

    private async Task ChangePasswordAsync()
    {
        _passwordError = null;

        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword) || string.IsNullOrWhiteSpace(_confirmPassword))
        {
            _passwordError = "All fields are required.";
            return;
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _passwordError = "New passwords do not match.";
            return;
        }

        try
        {
            await Client.ChangePasswordAsync(new ChangePasswordRequest(_currentPassword, _newPassword));
            Snackbar.Add("Password changed", Severity.Success);
            _currentPassword = _newPassword = _confirmPassword = string.Empty;
        }
        catch (HttpRequestException)
        {
            _passwordError = "Current password is incorrect.";
        }
    }

    private async Task SaveAsync()
    {
        var request = new SaveSettingsRequest(
            _isDark ? "dark" : "light",
            _gitHubToken,
            _enabled.Select(a => a.ToString()).ToList().AsReadOnly());
        await Client.SaveSettingsAsync(request);
        Snackbar.Add("Settings saved", Severity.Success);
        Navigation.NavigateTo("/settings", forceLoad: true);
    }
}
