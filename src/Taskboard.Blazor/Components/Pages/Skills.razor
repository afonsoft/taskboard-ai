@page "/skills"
@attribute [Authorize]
@inject TaskboardClient Client

<PageTitle>Skills - Taskboard</PageTitle>

<h1 class="mb-2 text-2xl font-bold text-text">Skills</h1>
<p class="mb-6 text-sm text-text-muted">Installed agent skills</p>

<div class="card">
    <div class="mb-4 flex items-center gap-3">
        <input type="search" class="input max-w-md" placeholder="Search skills..." value="@_search" @oninput="OnSearchInput" />
    </div>
    @if (_loading)
    {
        <Loading Message="Loading skills..." />
    }
    else if (!_filteredSkills.Any())
    {
        <EmptyState Message="No skills found." />
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Source</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var skill in _filteredSkills)
                    {
                        <tr>
                            <td class="font-medium text-text">@skill.Name</td>
                            <td class="text-text-muted">@skill.Source</td>
                            <td class="text-text-muted">@skill.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private string _search = string.Empty;
    private IReadOnlyList<SkillDto> _skills = [];
    private IReadOnlyList<SkillDto> _filteredSkills = [];

    protected override async Task OnInitializedAsync()
    {
        _skills = await Client.GetSkillsAsync();
        _filteredSkills = _skills;
        _loading = false;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _filteredSkills = _skills.Where(Filter).ToList();
    }

    private bool Filter(SkillDto skill)
    {
        return string.IsNullOrWhiteSpace(_search)
            || skill.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || skill.Description.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || skill.Source.Contains(_search, StringComparison.OrdinalIgnoreCase);
    }
}
